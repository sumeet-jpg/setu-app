# =============================================================
# SETU APP — ENVIRONMENT TEMPLATE
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.
# Do NOT prefix server-side secrets with NEXT_PUBLIC_.
# =============================================================

# ---------------------------
# App
# ---------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://setuagents.com
NEXT_PUBLIC_APP_ENV=development

# ---------------------------
# Supabase — Public (safe for client)
# ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ---------------------------
# Supabase — Server-side only (NEVER prefix with NEXT_PUBLIC_)
# ---------------------------
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Database (% encode special chars — # becomes %23)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ---------------------------
# Auth
# ---------------------------
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# ---------------------------
# LLM — Server-side only (NEVER expose to frontend)
# ---------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model names — use env vars, never hardcode in source
PRIMARY_REASONING_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini
FALLBACK_REASONING_MODEL=claude-sonnet-4-20250514
DEFAULT_LLM_PROVIDER=openai

# ---------------------------
# Email (Resend) — Server-side only
# ---------------------------
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=Setu <admin@setuagents.com>
ADMIN_ALERT_EMAIL=admin@setuagents.com

# ---------------------------
# App Secrets — Server-side only
# ---------------------------
APP_SECRET=generate_a_strong_random_secret_here
ENCRYPTION_KEY=generate_a_strong_random_encryption_key_here
WEBHOOK_SIGNING_SECRET=generate_a_strong_random_webhook_secret_here
CRON_SECRET=generate_a_strong_random_secret_for_cron_auth

# Required — signs manage-session tokens (src/lib/manage-token.ts). Without
# this set, every gated route (subscription actions, beliefs, calibration,
# cortex, pin, vault) throws instead of silently trusting an unsigned userId.
MANAGE_TOKEN_SECRET=generate_a_strong_random_secret_here

# Optional — lets scripts/cron call admin routes via an x-admin-secret header
# instead of a real login session.
ADMIN_SECRET=generate_a_strong_random_secret_here

# REQUIRED — the only email(s) allowed to be an admin (comma-separated for
# more than one). /signin is a public page with open Google/GitHub OAuth and
# no other invite check — without this set, admin-guard.ts fails closed and
# NOBODY can access /admin, which is correct but means you must set this
# before you'll be able to log in yourself. Previously (bug, now fixed) any
# successful login on /signin granted full admin access to anyone.
ADMIN_EMAIL=you@setuagents.com

# Required for billing. Without DODO_WEBHOOK_SECRET the webhook route refuses
# every request (fails closed) rather than accepting unsigned payment events.
DODO_API_KEY=your_dodo_payments_api_key_here
DODO_WEBHOOK_SECRET=your_dodo_webhook_signing_secret_here
DODO_PRODUCT_ID=your_dodo_product_id_here
DODO_ENV=live_mode

# ---------------------------
# WorkOS AuthKit (enterprise/admin SSO) — src/app/api/auth/sso/*
# WORKOS_CLIENT_ID and the redirect URI come from the WorkOS dashboard
# (Configuration → Redirects). The redirect URI registered there must exactly
# match NEXT_PUBLIC_WORKOS_REDIRECT_URI below.
# ---------------------------
WORKOS_API_KEY=sk_live_or_sk_test_your_workos_api_key
WORKOS_CLIENT_ID=client_your_workos_client_id
WORKOS_COOKIE_PASSWORD=generate_a_strong_random_32plus_char_secret
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://setuagents.com/api/auth/sso/callback

# ---------------------------
# PostHog (product analytics + error tracking)
# NEXT_PUBLIC_POSTHOG_KEY is the PROJECT key (starts phc_) — safe to expose
# client-side, write-only. Never use the personal API key (phx_) here.
# Without this set, tracking calls are silent no-ops — the app works either way.
# ---------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------
# Runtime (keep disabled until enterprise runtime is activated)
# ---------------------------
RUNTIME_MODE=control_plane_only
RUNTIME_EXECUTION_ENABLED=false
RUNTIME_PROVIDER=n8n
RUNTIME_PROVIDER_ACTIVATION_STATUS=pending_upgrade

# ---------------------------
# Storage Buckets
# ---------------------------
SUPABASE_STORAGE_BUCKET_BLUEPRINTS=blueprints
SUPABASE_STORAGE_BUCKET_UPLOADS=uploads
SUPABASE_STORAGE_BUCKET_SANDBOX=sandbox-files

# ---------------------------
# Governance
# ---------------------------
FILE_DELETE_REQUIRES_ADMIN_APPROVAL=true
FILE_EXTERNAL_SHARE_REQUIRES_ADMIN_APPROVAL=true
FILE_PERMISSION_CHANGE_REQUIRES_ADMIN_APPROVAL=true
FILE_BULK_DELETE_RESTRICTED=true
