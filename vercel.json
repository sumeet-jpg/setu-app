{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [],
  "redirects": [],
  "crons": [
    {
      "path": "/api/cron/decay",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/trials",
      "schedule": "0 8 * * *"
    }
  ]
}
