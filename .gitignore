# =============================================================
# SETU — .gitignore
# =============================================================

# ----- Secrets (CRITICAL — never commit these) -----
.env.local
.env.*.local
*.pem
*.key

# ----- Next.js -----
/.next/
/out/
/build
next-env.d.ts

# ----- Node -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----- Vercel -----
.vercel

# ----- TypeScript -----
*.tsbuildinfo

# ----- OS -----
.DS_Store
Thumbs.db
*.swp
*.swo

# ----- Supabase -----
supabase/.branches
supabase/.temp

# ----- Editor -----
.vscode/settings.json
.idea/

# ----- Logs -----
logs/
*.log
